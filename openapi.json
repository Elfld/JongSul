{
  "openapi": "3.1.0",
  "info": {
    "title": "Inha LostFound API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/main"
    }
  ],
  "paths": {
    "/health_check": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root_health_check_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          }
        }
      }
    },
    "/items/": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Get All Lost Items",
        "description": "모든 분실물 리스트를 반환합니다.",
        "operationId": "get_all_lost_items_items__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  },
                  "type": "array",
                  "title": "Response Get All Lost Items Items  Get"
                }
              }
            }
          }
        }
      }
    },
    "/items/search": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Search Lost Items",
        "description": "(1.2) 검색어(q) 및/또는 태그(tags)로 분실물을 검색합니다.\n- q: 검색어\n- tags: 태그 ID 리스트 (여러 개 가능)",
        "operationId": "search_lost_items_items_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tags"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  },
                  "title": "Response Search Lost Items Items Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/items/me": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Get My Claimed Items",
        "description": "(인증 필요) 현재 로그인한 사용자가 '주인 등록(claim)'한\n모든 분실물 리스트를 반환합니다.",
        "operationId": "get_my_claimed_items_items_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  },
                  "type": "array",
                  "title": "Response Get My Claimed Items Items Me Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/items/me/{item_id}/cancel": {
      "post": {
        "tags": [
          "Items"
        ],
        "summary": "Cancel My Reservation",
        "description": "(인증 필요) 현재 사용자가 '예약'한 픽업을 취소하고\n사유를 기록합니다. 아이템 상태는 '보관'으로 돌아갑니다.",
        "operationId": "cancel_my_reservation_items_me__item_id__cancel_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationCancelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/items/me/{item_id}": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Get My Claimed Item Detail",
        "description": "(인증 필요) 현재 사용자가 '주인 등록'한 특정 아이템의\n상세 정보와 픽업 코드를 (만료 시 재발급하여) 반환합니다.",
        "operationId": "get_my_claimed_item_detail_items_me__item_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyItemDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/items/{item_id}": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Get Item By Id",
        "description": "지정된 ID의 단일 분실물 상세 내역을 반환합니다.",
        "operationId": "get_item_by_id_items__item_id__get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/items/{item_id}/claim": {
      "post": {
        "tags": [
          "Items"
        ],
        "summary": "Claim Lost Item",
        "description": "(인증 필요) 현재 로그인한 사용자가 특정 분실물의\n주인으로 등록(claim)합니다.",
        "operationId": "claim_lost_item_items__item_id__claim_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/register": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create User",
        "description": "사용자 회원가입 (컨트롤러)",
        "operationId": "create_user_users_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Login For Access Token",
        "description": "로그인 후 Access Token 발급 (컨트롤러)",
        "operationId": "login_for_access_token_users_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tags/": {
      "get": {
        "tags": [
          "Tags"
        ],
        "summary": "Get All Tags",
        "description": "DB에 저장된 모든 태그 리스트를 반환합니다.",
        "operationId": "get_all_tags_tags__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TagResponse"
                  },
                  "type": "array",
                  "title": "Response Get All Tags Tags  Get"
                }
              }
            }
          }
        }
      }
    },
    "/kiosk/pickup": {
      "post": {
        "tags": [
          "Kiosk"
        ],
        "summary": "Complete Item Pickup",
        "description": "(키오스크 전용) 픽업 코드를 검증하고, 유효하면 해당 분실물의 상태를\n'보관'에서 '찾음'으로 변경합니다.",
        "operationId": "complete_item_pickup_kiosk_pickup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KioskPickupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dev/create-dummy-items": {
      "post": {
        "tags": [
          "Development"
        ],
        "summary": "Generate Dummy Items",
        "description": "테스트용 가상 분실물을 생성합니다. (개발용, 실제로 절대 쓰지 마세요.)\n- count: 생성할 아이템 개수 (기본 10, 최대 50)",
        "operationId": "generate_dummy_items_dev_create_dummy_items_post",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "exclusiveMinimum": 0,
              "default": 10,
              "title": "Count"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  },
                  "title": "Response Generate Dummy Items Dev Create Dummy Items Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimResponse": {
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          },
          "pickup_code": {
            "$ref": "#/components/schemas/PickupCodeResponse"
          }
        },
        "type": "object",
        "required": [
          "item",
          "pickup_code"
        ],
        "title": "ClaimResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "photo_url": {
            "type": "string",
            "title": "Photo Url"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "registered_at": {
            "type": "string",
            "format": "date-time",
            "title": "Registered At"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagResponse"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "photo_url",
          "status",
          "registered_at"
        ],
        "title": "ItemResponse"
      },
      "KioskPickupResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          }
        },
        "type": "object",
        "required": [
          "message",
          "item"
        ],
        "title": "KioskPickupResponse"
      },
      "MyItemDetailResponse": {
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          },
          "pickup_code": {
            "$ref": "#/components/schemas/PickupCodeResponse"
          }
        },
        "type": "object",
        "required": [
          "item",
          "pickup_code"
        ],
        "title": "MyItemDetailResponse"
      },
      "PickupCodeResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "expires_at"
        ],
        "title": "PickupCodeResponse"
      },
      "PickupRequest": {
        "properties": {
          "pickup_code": {
            "type": "string",
            "title": "Pickup Code"
          }
        },
        "type": "object",
        "required": [
          "pickup_code"
        ],
        "title": "PickupRequest"
      },
      "ReservationCancelRequest": {
        "properties": {
          "cancel_reason": {
            "type": "string",
            "title": "Cancel Reason"
          }
        },
        "type": "object",
        "required": [
          "cancel_reason"
        ],
        "title": "ReservationCancelRequest"
      },
      "TagResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "TagResponse"
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type"
        ],
        "title": "Token"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "contact_info": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Info"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "UserCreate"
      },
      "UserLogin": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "UserLogin"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  }
}
